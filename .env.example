# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./deadlines.db
ACCESS_TOKEN_MINUTES=60

# Reminder job: how often it scans, and how many hours before a deadline to remind
SCAN_INTERVAL_MINUTES=15
REMINDER_WINDOWS_HOURS=72,24,3

# Optional: send reminders by email too (leave SMTP_HOST empty to only store them in the DB)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reminders@example.com
